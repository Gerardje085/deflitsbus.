# Force HTTPS + non-WWW
RewriteEngine On

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://deflitsbus.nl%{REQUEST_URI} [R=301,L,NE]

# Redirect index.html/php to root
RewriteCond %{THE_REQUEST} /index\.(html|php)[\s?] [NC]
RewriteRule ^(.*/)index\.(html|php)$ /$1 [R=301,L,NE]

# Redirect specifieke oude pagina's naar secties op de nieuwe hoofdpagina
Redirect 301 /about https://deflitsbus.nl/#about
Redirect 301 /contact https://deflitsbus.nl/#contact
Redirect 301 /galerij https://deflitsbus.nl/#galerij
Redirect 301 /prijzen https://deflitsbus.nl/#prijzen

# Voor alle andere niet-bestaande pagina's → 404
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]

# Allow static assets
<FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|ico|woff2?|ttf|otf|json|txt|xml)$">
  Require all granted
</FilesMatch>

# Security headers
Header unset X-Powered-By
Header unset Server

# Content Security Policy (CSP)
Header set Content-Security-Policy "default-src 'self' https://usebasin.com https://fonts.googleapis.com https://www.googletagmanager.com https://www.google-analytics.com; \
                                    script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com 'unsafe-inline'; \
                                    connect-src 'self' https://usebasin.com https://www.google-analytics.com; \
                                    style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com 'unsafe-inline'; \
                                    font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; \
                                    img-src 'self' data: https://www.google-analytics.com;"

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Compressie
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE \
    text/html \
    text/css \
    application/javascript \
    image/svg+xml \
    font/ttf \
    font/otf \
    font/woff2
</IfModule>

# Blokkeer gevoelige bestanden
<FilesMatch "(\.env|\.git|composer\..*)">
  Require all denied
</FilesMatch>

# Disable directory listing
Options -Indexes